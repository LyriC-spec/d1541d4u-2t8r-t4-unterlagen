# Kopieren nach .env und anpassen (chmod 600 .env)
BMC_HOST=192.0.2.10
BMC_USER=admin
BMC_PASSWORD=
# optional: eigener BMC-Benutzer nur fuer die Konsole (Web-Login laeuft im Klartext)
BMC_WEB_USER=
BMC_WEB_PASSWORD=
# leer lassen: dann wird ein Kennwort erzeugt und in data/ui_password abgelegt
UI_PASSWORD=
